# --- App ---
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:3000"]

# --- Database / RAG vector store (compose overrides DATABASE_URL per stack) ---
DATABASE_URL=postgresql+asyncpg://tickerlens:tickerlens@localhost:5432/tickerlens
# Required by docker-compose.prod.yml — generate one, do not reuse the dev value.
# Use hex, NOT base64: this value is interpolated into DATABASE_URL, and the
# "/" and "+" that base64 produces get parsed as DSN separators.
#   openssl rand -hex 24
POSTGRES_PASSWORD=

# --- Market data & news ---
# Free key: https://finnhub.io/register
FINNHUB_API_KEY=
# Optional, improves news/price coverage: https://alpaca.markets
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# SEC EDGAR requires a descriptive User-Agent with a contact email
EDGAR_USER_AGENT=TickerLens (you@example.com)

# --- AI (OpenAI-compatible) ---
AI_ENGINE=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Named by role. Check `GET /models` on your endpoint before changing these —
# aliases like "deepseek-chat" can be repointed upstream without notice.
AI_MODEL_VERDICT=deepseek-v4-pro
AI_MODEL_NARRATIVE=deepseek-v4-flash

# --- RAG ---
# 384-dim model; changing it means changing EMBED_DIM and reindexing.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RAG_CHUNKS_PER_TICKER=6

# --- Public demo protection ---
RATE_LIMIT_ANALYSIS=10/hour
RATE_LIMIT_DATA=60/minute
